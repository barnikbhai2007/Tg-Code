# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to git or share it with anyone.

# Get this from @BotFather on Telegram after running /newbot
BOT_TOKEN=

# Your personal numeric Telegram user ID (get it from @userinfobot)
ADMIN_CHAT_ID=

# A long random secret used by trusted approvers to approve payments
# via /approve command instead of tapping the inline button.
# Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_APPROVAL_TOKEN=

# Gmail address that receives your site's verification codes
EMAIL_ADDRESS=youraddress@gmail.com

# Google App Password (NOT your Gmail login password).
# Requires 2FA enabled on your Google account.
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_APP_PASSWORD=

# Only emails from this sender will be treated as valid codes.
# This stops the bot from ever relaying an unrelated/spoofed email.
CODE_SENDER_FILTER=noreply@yoursite.com

# How long a subscription lasts after approval
SUBSCRIPTION_DAYS=30
SUBSCRIPTION_PRICE_INR=499

# Your UPI ID shown to users for payment
UPI_ID=yourname@okhdfcbank

DB_PATH=subscriptions.db
